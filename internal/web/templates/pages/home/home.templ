package templates

import (
    "github.com/ndrscodes/yasp/internal/db"
    "github.com/ndrscodes/yasp/internal/web/templates/layout"
)

type SystemData struct {
    Systems []*db.System
    Error   error
}

templ Index(info SystemData) {
    @templates.Base(info.Error) {
        <div class="px-4 md:px-0 md:flex justify-center items-center">
            <div class="md:w-2/3 rounded-lg border-2 border-gray-300 shadow-md">
                <div class="bg-gray-800 text-white rounded-t-lg py-2 px-4">
                    <h2 class="text-xl font-semibold">System Status</h2>
                </div>
                for _, sys := range info.Systems {
                    <div class="system-container text-lg">
                        <div>{ sys.Name }</div>
                        <div class="operational text-lg">Operational</div>
                    </div>
                }
            </div>
        </div>
    }
}