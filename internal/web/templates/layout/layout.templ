package templates

templ Base(err error) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/static/css/output.css">
        <title>Document</title>
    </head>
    <body class="h-screen bg-gray-100">
        <nav class="mb-8">
            <div class="bg-gradient-to-tr from-green-400 to-blue-500 text-white text-center text-3xl py-6 shadow-md">
                <h1>Status Page</h1>
            </div>
        </nav>
        if err != nil {
            <div class="text-center text-red-500 py-10">
            { err.Error() }
            </div>
        }
        { children... }
    </body>

    </html>
}